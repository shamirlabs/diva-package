network_params:
  network_id: "3151908"
  genesis_delay: 10 #-1                 # If -1, it is overwritten by DIVA
  deneb_fork_epoch: 0
  electra_fork_epoch: 999999
  preregistered_validator_count: -1     # If -1, it is overwritten by DIVA
  preset: minimal

diva_params:
  diva_validators: 1
  diva_nodes: 5
  diva_external_nodes: false
  diva_val_type: nimbus
  distribution: "[]"                    # Array-index is node-index and array value is number of keyshares, if empty will be randomly distributed
  
  options:
    deploy_eth: true
    deploy_diva_nodes: true
    deploy_diva_coord_boot: true
    deploy_diva_sc: true
    deploy_oracle: true

    deposit_operators_eth: 70
    diva_prover: true 
    diva_submitter: true
    diva_heartbeat: true

    private_pools_only: false           # TODO: validar diva_sc and eth_true and nodes_true
    deploy_operator_ui: false
    public_ports: false
    public_bootnodes: false
    verify_fee_recipient: false
    eth_connection_enabled: true
    debug_nodes: false
    tracing: true
  use_w3s: false

participants:
  - el_type: geth
    #el_image: ethereum/client-go:v1.13.15
    #el_extra_params: ["--gcmode=archive","--syncmode=full","--state.scheme=hash","--http.api='admin,eth,net,debug,txpool'","--http.corsdomain=*"]
    cl_type: lighthouse
    #cl_extra_params: ["--enable-debug-rpc-endpoints"]
    #cl_extra_params: ["--reconstruct-historic-states","--http-allow-origin=*"]
    validator_count: 64
    use_separate_vc: true
    node_selectors: { "participant": "eth" }
    count: 2
  
# Ethereum nodes for diva connections
# Nodes with 0 validators will be used by diva nodes and connections will be uniformely distributed between them

additional_services:
  #- tx_spammer
  #- blob_spammer
  #- custom_flood
  #- el_forkmon
  #- beacon_metrics_gazer
  - dora
  #- prometheus_grafana
  #- full_beaconchain_explorer
  #- blockscout
  #- apache

#persistent: true
mev_type: null
mev_params:
  mev_relay_image: flashbots/mev-boost-relay:latest
  mev_builder_extra_args: [--builder.secret_key="0x2fc12ae741f29701f8e30f5de6350766c020cb80768a0ff01e6838ffd2431e11",--miner.extradata="DIVA MEV BUILDER"]

port_publisher:
  el:
    enabled: true
    public_port_start: 32000
  cl:
    enabled: true
    public_port_start: 33000
  vc:
    enabled: true
    public_port_start: 34000
  additional_services:
    enabled: true
    public_port_start: 35000
